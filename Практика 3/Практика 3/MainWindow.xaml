<Window x:Class="Практика_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практика_3"
        mc:Ignorable="d"
        Title="Бронирование номера" Height="525" Width="800">
    <DockPanel Width="Auto" LastChildFill="False" Background="GhostWhite">

        <Label Background="CadetBlue" Content="Бронирование номера" Height="50" DockPanel.Dock="Top" Foreground="White"  FontSize="20" FontWeight="Medium" VerticalContentAlignment="Center"/>

        <Grid DockPanel.Dock="Top" Height ="375" Margin="10, 10, 10, 0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Margin="10,10,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*" />
                        <ColumnDefinition Width="6.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <StackPanel>
                            <Label Content="Гость" FontWeight="Bold" Height="24" FontSize="13"/>
                            <Label Content="ФИО"/>
                            <Label Content="Телефон" Margin="0,3,5,2.5"/>
                            <Label Content="Электронная почта" Margin="0,3,5,2.5"/>
                            <Label Content="Количество гостей" Margin="0,2,5,2.5"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel>
                            <TextBox Margin="0,22.5,5,2.5" Height="25"/>
                            <TextBox Margin="0,2.5,5,2.5" Height="25"/>
                            <TextBox Height="25" Margin="0,2.5,5,2.5"/>
                            <ComboBox Height="25" Margin="0,2.5,5,2.5">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Grid.Row="0" Margin="5,10,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <StackPanel>
                            <Label Content="Проживание" FontWeight="Bold" Height="26.5"  FontSize="13"/>
                            <Label Content="Дата заезда"/>
                            <Label Content="Дата выезда" Margin="0,2,5,2.5"/>
                            <Label Content="Категория номера" Margin="0,1,5,2.5"/>
                            <Label Content="Способ оплаты" Margin="0,2,5,2.5"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel>
                            <DatePicker Margin="0,25,5,2.5" Height="25"/>
                            <DatePicker Margin="0,2.5,5,2.5" Height="25"/>
                            <ComboBox Height="25" Margin="0,2.5,5,2.5">
                                <ComboBoxItem Content="Стандарт"/>
                                <ComboBoxItem Content="Премиум"/>
                                <ComboBoxItem Content="Люкс"/>
                            </ComboBox>
                            <ComboBox Height="25" Margin="0,2.5,5,2.5">
                                <ComboBoxItem Content="Банковская карта"/>
                                <ComboBoxItem Content="Наличка"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

            </Border>
        
        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel>
                    <Label Content="Дополнительные услуги" FontWeight="Bold" FontSize="12"/>
                    <WrapPanel Margin="2">
                        <CheckBox Content="Завтрак" Margin="5"/>
                        <CheckBox Content="Парковка" Margin="5"/>
                        <CheckBox Content="Трансфер" Margin="5"/>
                        <CheckBox Content="Поздний выезд" Margin="5"/>
                        <CheckBox Content="Детская кроватка" Margin="5"/>
                        <CheckBox Content="Размещение с животными" Margin="5"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Ночей: 3" Margin="3, 10, 10, 0"/>
                        <Label Content="Стоимость номера: 4 000 Р/сутка" Margin="3, 10, 10, 0"/>
                        <Label Content="Итого: 12 000Р" FontWeight="Bold" Margin="3, 10, 10, 0"/>
                    </StackPanel>
                </StackPanel>
        </Border>
        
        </Grid>

        
        <Button Content="Отмена" Width="65" Height="25" VerticalAlignment="Bottom" DockPanel.Dock="Right" Margin="2.5, 0, 15, 10">

        </Button>

        <Button Content="Забронировать" Width="100" Height="25" VerticalAlignment="Bottom" DockPanel.Dock="Right" Margin="0, 0, 2.5, 10">

        </Button>
    </DockPanel>
</Window>
